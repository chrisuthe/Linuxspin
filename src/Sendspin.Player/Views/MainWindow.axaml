<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sendspin.Player.ViewModels"
        xmlns:views="using:Sendspin.Player.Views"
        xmlns:media="using:Sendspin.Core.MediaSession"
        mc:Ignorable="d"
        x:Class="Sendspin.Player.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sendspin Player"
        Width="440" Height="700"
        MinWidth="400" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{x:Null}">

    <!--
      Native shell: resizable, the platform's own decorations, the system's light/dark variant
      and accent, the platform's font. The composition inside the window comes from Sendspin for
      Windows — a phone-shaped, dark-only, custom-chrome player — and its colours do not. The
      per-platform hints (Mica on Windows 11, the extended title strip on macOS) are set in the
      code-behind, which is also where the opaque root's opacity and the toolbar's inset are
      kept in step with what the platform actually granted.

      The window's own background is null so that the layer stack below is the only thing that
      paints: on Linux the window has an alpha channel by default, and on Windows Mica needs to
      show through, so the first layer is an opaque root and everything translucent sits on it.
    -->

    <Panel Name="LayerStack">

        <!-- Opaque root: the one layer that always paints. -->
        <Border Name="OpaqueRoot"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}" />

        <!--
          Layer 0: blurred artwork. The source is the artwork scaled to 64 px by the view model,
          so the blur runs over a tiny bitmap and, as the spike's blur-once case measured, is paid
          once and cached rather than re-run per frame. The negative margin lets the blur's soft
          edge fall outside the window instead of fading to the opaque root along the border.
        -->
        <Panel Name="ArtBackdrop" IsVisible="{Binding HasArtBackdrop}">
            <Image Name="ArtBackdropImage"
                   Source="{Binding ArtBackdrop}"
                   Stretch="UniformToFill"
                   Margin="-48">
                <Image.Effect>
                    <BlurEffect Radius="32" />
                </Image.Effect>
            </Image>
        </Panel>

        <!-- Layer 0b: the ambient backdrop. Phase 5 fills this and flips HasAmbientBackdrop. -->
        <ContentControl Name="AmbientBackdrop" IsVisible="{Binding HasAmbientBackdrop}" />

        <!-- Layer 1: the veil, so theme-foreground text keeps its contrast over either backdrop. -->
        <Border Name="Veil"
                Background="{DynamicResource VeilBrush}"
                IsVisible="{Binding HasBackdrop}" />

        <!-- Layer 2: the content. -->
        <Grid Name="ContentLayer" RowDefinitions="Auto,*,Auto">

            <!-- Toolbar: the connection line, and the settings toggle. -->
            <Border Grid.Row="0" Name="Toolbar" Classes="toolbar">
                <!-- ToolbarContent's margin is the code-behind's: the macOS title strip inset. -->
                <Grid Name="ToolbarContent" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Name="ConnectionLine"
                               Text="{Binding ConnectionStatus}"
                               Classes="caption"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <ToggleButton Grid.Column="1"
                                  Name="SettingsButton"
                                  Classes="iconButton"
                                  IsChecked="{Binding IsSettingsOpen, Mode=OneWay}"
                                  Command="{Binding ToggleSettingsCommand}"
                                  ToolTip.Tip="Settings">
                        <PathIcon Data="{StaticResource GearIcon}" />
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- Body: Now Playing or Welcome, with the settings card and the prompt over it. -->
            <Panel Grid.Row="1" Name="Body">

                <!--
                  Now Playing fills the body rather than scrolling in it: it sizes its art to
                  the room it has, which needs a real height to size against.
                -->
                <views:NowPlayingView Name="NowPlaying"
                                      IsVisible="{Binding IsConnected}" />

                <ScrollViewer IsVisible="{Binding !IsConnected}">
                    <views:WelcomeView Name="Welcome" />
                </ScrollViewer>

                <!--
                  Settings, as a card over the whole body rather than a side column: at 440 px a
                  340 px pane would swallow the window. The card is a header, the scrolling body
                  (SettingsView, over this same view model) and a footer with the version and
                  Done. Done only closes the card: every setting has already been written.
                -->
                <Border Name="SettingsOverlay"
                        Classes="settingsOverlay"
                        IsVisible="{Binding IsSettingsOpen}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Row="0"
                                    Name="SettingsHeader"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,0,0,12">
                            <PathIcon Data="{StaticResource GearIcon}"
                                      Width="20" Height="20"
                                      VerticalAlignment="Center" />
                            <TextBlock Name="SettingsTitle"
                                       Text="Settings"
                                       Classes="subtitle"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1">
                            <views:SettingsView Name="SettingsBody" Margin="0,0,4,0" />
                        </ScrollViewer>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <TextBlock Grid.Column="0"
                                       Name="VersionText"
                                       Text="{Binding Settings.AppVersion, StringFormat='Sendspin Player {0}'}"
                                       Classes="caption"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Name="DoneButton"
                                    Content="Done"
                                    Classes="primary"
                                    Command="{Binding CloseSettingsCommand}" />
                        </Grid>
                    </Grid>
                </Border>

                <!--
                  The auto-connect question, once per server, after a connection the user made in
                  discover mode. A card at the foot of the body, over Now Playing, rather than a
                  dialog: it is a question about this connection, and it should not take the
                  window away from what just started playing.
                -->
                <Border Name="AutoConnectPrompt"
                        Classes="promptCard"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsAutoConnectPromptOpen}">
                    <StackPanel Spacing="12">
                        <TextBlock Name="PromptServerLine"
                                   Classes="subtitle"
                                   Text="{Binding ServerName, StringFormat='Connected to {0}'}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="body"
                                   Text="Always connect to this server when it's available?"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Name="NotNowButton"
                                    Content="Not now"
                                    Command="{Binding AutoConnectNotNowCommand}" />
                            <Button Name="JustOnceButton"
                                    Content="Just once"
                                    Command="{Binding AutoConnectJustOnceCommand}" />
                            <Button Name="AlwaysButton"
                                    Content="Always"
                                    Classes="primary"
                                    Command="{Binding AutoConnectAlwaysCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>

            <!--
              Footer: the volume row while connected, the status message while disconnected with
              one to show, and nothing at all otherwise — a disabled volume row under a screen
              with no connection said nothing.
            -->
            <Border Grid.Row="2" Name="Footer" Classes="footer" IsVisible="{Binding HasFooter}">
                <Panel>
                    <Grid Name="VolumeRow"
                          ColumnDefinitions="Auto,*,Auto,Auto"
                          IsVisible="{Binding IsConnected}">
                        <ToggleButton Grid.Column="0"
                                      Name="MuteButton"
                                      Classes="iconButton"
                                      IsChecked="{Binding IsMuted}"
                                      ToolTip.Tip="Mute">
                            <Panel>
                                <PathIcon Data="{StaticResource SpeakerIcon}" IsVisible="{Binding !IsMuted}" />
                                <PathIcon Data="{StaticResource MutedIcon}" IsVisible="{Binding IsMuted}" />
                            </Panel>
                        </ToggleButton>

                        <!-- Avalonia's Slider already jumps to the pressed point; there is no switch for it. -->
                        <Slider Grid.Column="1"
                                Name="VolumeSlider"
                                Value="{Binding Volume}"
                                Minimum="0" Maximum="100"
                                VerticalAlignment="Center"
                                Margin="8,0" />

                        <TextBlock Grid.Column="2"
                                   Name="VolumeText"
                                   Text="{Binding Volume, StringFormat='{}{0}%'}"
                                   Classes="caption"
                                   MinWidth="36"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />

                        <!-- Off for a single-room setup; Disconnect lives in Settings' Connection section. -->
                        <Button Grid.Column="3"
                                Name="SwitchGroupButton"
                                Classes="iconButton"
                                Command="{Binding SwitchGroupCommand}"
                                IsVisible="{Binding Settings.ShowSwitchGroupButton}"
                                ToolTip.Tip="Switch group">
                            <PathIcon Data="{StaticResource SwitchGroupIcon}" />
                        </Button>
                    </Grid>

                    <TextBlock Name="FooterStatus"
                               Text="{Binding StatusMessage}"
                               Classes="warning"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HasFooterStatus}" />
                </Panel>
            </Border>
        </Grid>
    </Panel>
</Window>
