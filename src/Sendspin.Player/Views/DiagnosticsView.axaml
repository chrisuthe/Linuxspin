<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sendspin.Player.ViewModels"
             mc:Ignorable="d"
             x:Class="Sendspin.Player.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

    <Border Classes="diagnostics">
        <StackPanel Spacing="6">
            <TextBlock Text="Diagnostics" Classes="h2" />

            <!--
              The timing source is called out first and warned about, because it decides whether
              any of the sync figures below it mean anything: "wall-clock" means the platform
              backend is not supplying a hardware audio clock and everything else here is resting
              on the OS timer.
            -->
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Timing source" Classes="metricLabel" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Snapshot.TimingSource, FallbackValue='—'}" Classes="metricValue" />
                    <TextBlock Text="(not a hardware clock)"
                               Classes="warning"
                               IsVisible="{Binding !IsUsingAudioClock}" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Sync error" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Classes="metricValue">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:+0.000;-0.000;0.000} ms — {1}">
                            <Binding Path="SyncErrorMs" />
                            <Binding Path="CorrectionBand" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Correction mode" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Text="{Binding Snapshot.CorrectionMode, FallbackValue='—'}"
                           Classes="metricValue" />
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Playback rate" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Classes="metricValue">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F6} ({1:+0;-0;0} ppm, ceiling ±500)">
                            <Binding Path="Snapshot.PlaybackRate" />
                            <Binding Path="PlaybackRatePpm" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Buffered" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Text="{Binding Snapshot.BufferedMilliseconds, StringFormat='{}{0:F1} ms'}"
                           Classes="metricValue" />
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Clock offset / drift" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Classes="metricValue">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F3} ms, {1:F1} µs/s (±{2:F0} µs, converged: {3}), post-anchor {4:F3} ms">
                            <Binding Path="Snapshot.ClockOffsetMilliseconds" />
                            <Binding Path="Snapshot.ClockDriftMicrosecondsPerSecond" />
                            <Binding Path="Snapshot.ClockOffsetUncertaintyMicroseconds" />
                            <Binding Path="Snapshot.ClockConverged" />
                            <Binding Path="Snapshot.ClockDriftMs" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Round trip" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Text="{Binding Snapshot.RoundTripMicroseconds, StringFormat='{}{0:F0} µs'}"
                           Classes="metricValue" />
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Output latency" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Classes="metricValue">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} ms measured + {1:F1} ms manual = {2:F1} ms">
                            <Binding Path="Snapshot.OutputLatencyMs" />
                            <Binding Path="Snapshot.ManualLatencyOffsetMs" />
                            <Binding Path="TotalLatencyMs" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Static delay" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Text="{Binding Snapshot.StaticDelayMs, StringFormat='{}{0:F1} ms'}"
                           Classes="metricValue" />
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Stream" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Text="{Binding FormatSummary}" Classes="metricValue" />
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Output device" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Text="{Binding Snapshot.AudioDeviceName, FallbackValue='—'}"
                           Classes="metricValue" TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnDefinitions="180,*">
                <TextBlock Grid.Column="0" Text="Platform" Classes="metricLabel" />
                <TextBlock Grid.Column="1" Text="{Binding Snapshot.PlatformName, FallbackValue='—'}"
                           Classes="metricValue" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
