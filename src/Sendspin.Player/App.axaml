<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sendspin.Player.App"
             RequestedThemeVariant="Default">

    <!--
      RequestedThemeVariant="Default" is what makes the app follow the system light/dark
      setting, and switch live when it changes, rather than pinning a theme. The player this
      one takes its feature set from is dark-only with custom chrome; that is the opposite of
      feeling native, so it is not copied.
    -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Sendspin.Player/Styles/PlayerStyles.axaml" />
    </Application.Styles>

</Application>
