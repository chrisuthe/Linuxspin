<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      One monochrome stroke set: every glyph is drawn on a 24-unit box with a 1.7-unit stroke,
      round caps and joins, and rendered by PathIcon in whatever Foreground it inherits — the
      theme foreground, or OnAccentBrush over the accent. The PathIcon control theme in
      PlayerStyles.axaml is what strokes these rather than filling them; play and pause are the
      exception and are filled through the "filled" class.

      Sources, both MIT:
        - shuffle, repeat, switch-group: Sendspin for Windows (src/Sendspin.Windows/MainWindow.xaml
          in https://github.com/chrisuthe/windowsSpin), same author. Repeat-one adds a "1" to repeat.
        - play, pause, previous (skip-back), next (skip-forward), speaker (volume-2), muted
          (volume-x), gear (settings), stats (bar-chart-2), music: Feather Icons 4.29.2,
          https://github.com/feathericons/feather, Copyright (c) 2013-2023 Cole Bemis.
    -->

    <StreamGeometry x:Key="PlayIcon">M5,3 L19,12 L5,21 Z</StreamGeometry>
    <StreamGeometry x:Key="PauseIcon">M6,4 H10 V20 H6 Z M14,4 H18 V20 H14 Z</StreamGeometry>
    <StreamGeometry x:Key="PreviousIcon">M19,20 L9,12 L19,4 Z M5,19 V5</StreamGeometry>
    <StreamGeometry x:Key="NextIcon">M5,4 L15,12 L5,20 Z M19,5 V19</StreamGeometry>
    <StreamGeometry x:Key="ShuffleIcon">M16,3 H21 V8 M4,20 L21,3 M21,16 V21 H16 M15,15 L21,21 M4,4 L9,9</StreamGeometry>
    <StreamGeometry x:Key="RepeatIcon">M17,2 L21,6 L17,10 M3,11 L3,10 A4,4 0 0 1 7,6 L21,6 M7,22 L3,18 L7,14 M21,13 L21,14 A4,4 0 0 1 17,18 L3,18</StreamGeometry>
    <StreamGeometry x:Key="RepeatOneIcon">M17,2 L21,6 L17,10 M3,11 L3,10 A4,4 0 0 1 7,6 L21,6 M7,22 L3,18 L7,14 M21,13 L21,14 A4,4 0 0 1 17,18 L3,18 M10.5,10.5 L12.5,9 V15</StreamGeometry>
    <StreamGeometry x:Key="SpeakerIcon">M11,5 L6,9 H2 V15 H6 L11,19 Z M15.54,8.46 A5,5 0 0 1 15.54,15.53 M19.07,4.93 A10,10 0 0 1 19.07,19.07</StreamGeometry>
    <StreamGeometry x:Key="MutedIcon">M11,5 L6,9 H2 V15 H6 L11,19 Z M23,9 L17,15 M17,9 L23,15</StreamGeometry>
    <StreamGeometry x:Key="SwitchGroupIcon">M4.4,3 H8 A1.4,1.4 0 0 1 9.4,4.4 V8 A1.4,1.4 0 0 1 8,9.4 H4.4 A1.4,1.4 0 0 1 3,8 V4.4 A1.4,1.4 0 0 1 4.4,3 Z M15.4,3 H19 A1.4,1.4 0 0 1 20.4,4.4 V8 A1.4,1.4 0 0 1 19,9.4 H15.4 A1.4,1.4 0 0 1 14,8 V4.4 A1.4,1.4 0 0 1 15.4,3 Z M4.4,14 H8 A1.4,1.4 0 0 1 9.4,15.4 V19 A1.4,1.4 0 0 1 8,20.4 H4.4 A1.4,1.4 0 0 1 3,19 V15.4 A1.4,1.4 0 0 1 4.4,14 Z M15.4,14 H19 A1.4,1.4 0 0 1 20.4,15.4 V19 A1.4,1.4 0 0 1 19,20.4 H15.4 A1.4,1.4 0 0 1 14,19 V15.4 A1.4,1.4 0 0 1 15.4,14 Z</StreamGeometry>
    <StreamGeometry x:Key="GearIcon">M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z M19.4,15 a1.65,1.65 0 0 0 .33,1.82 l.06,.06 a2,2 0 0 1 0,2.83 a2,2 0 0 1 -2.83,0 l-.06,-.06 a1.65,1.65 0 0 0 -1.82,-.33 a1.65,1.65 0 0 0 -1,1.51 V21 a2,2 0 0 1 -2,2 a2,2 0 0 1 -2,-2 v-.09 A1.65,1.65 0 0 0 9,19.4 a1.65,1.65 0 0 0 -1.82,.33 l-.06,.06 a2,2 0 0 1 -2.83,0 a2,2 0 0 1 0,-2.83 l.06,-.06 a1.65,1.65 0 0 0 .33,-1.82 a1.65,1.65 0 0 0 -1.51,-1 H3 a2,2 0 0 1 -2,-2 a2,2 0 0 1 2,-2 h.09 A1.65,1.65 0 0 0 4.6,9 a1.65,1.65 0 0 0 -.33,-1.82 l-.06,-.06 a2,2 0 0 1 0,-2.83 a2,2 0 0 1 2.83,0 l.06,.06 a1.65,1.65 0 0 0 1.82,.33 H9 a1.65,1.65 0 0 0 1,-1.51 V3 a2,2 0 0 1 2,-2 a2,2 0 0 1 2,2 v.09 a1.65,1.65 0 0 0 1,1.51 a1.65,1.65 0 0 0 1.82,-.33 l.06,-.06 a2,2 0 0 1 2.83,0 a2,2 0 0 1 0,2.83 l-.06,.06 a1.65,1.65 0 0 0 -.33,1.82 V9 a1.65,1.65 0 0 0 1.51,1 H21 a2,2 0 0 1 2,2 a2,2 0 0 1 -2,2 h-.09 a1.65,1.65 0 0 0 -1.51,1 Z</StreamGeometry>
    <StreamGeometry x:Key="StatsIcon">M18,20 V10 M12,20 V4 M6,20 V14</StreamGeometry>
    <StreamGeometry x:Key="MusicIcon">M9,18 V5 L21,3 V16 M9,18 A3,3 0 1 1 3,18 A3,3 0 1 1 9,18 Z M21,16 A3,3 0 1 1 15,16 A3,3 0 1 1 21,16 Z</StreamGeometry>

</ResourceDictionary>
