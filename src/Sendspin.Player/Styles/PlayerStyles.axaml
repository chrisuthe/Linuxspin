<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Everything here is expressed against the Fluent theme's own resources rather than fixed
      colours, so the app follows the system light/dark setting and the system accent instead of
      pinning one look. Hard-coded colours are what make an app look imported on someone else's
      desktop.
    -->

    <Style Selector="Border.header">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>

    <Style Selector="StackPanel.body">
        <Setter Property="Margin" Value="16" />
    </Style>

    <Style Selector="Border.transport">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>

    <Style Selector="Border.settingsPane">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>

    <Style Selector="Border.diagnostics">
        <Setter Property="Padding" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>

    <Style Selector="Border.artwork">
        <Setter Property="Width" Value="180" />
        <Setter Property="Height" Value="180" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>

    <Style Selector="TextBlock.artworkPlaceholder">
        <Setter Property="FontSize" Value="56" />
        <Setter Property="Opacity" Value="0.35" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.trackInfo">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style Selector="TextBlock.subtle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.65" />
    </Style>

    <Style Selector="TextBlock.warning">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="TextBlock.metricValue">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.metricLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.65" />
    </Style>

    <Style Selector="Button.transportButton">
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style Selector="ToggleButton.transportButton">
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
</Styles>
